PluginEditor::PluginEditor(PluginProcessor& processor)
    : AudioProcessorEditor(processor),
      m_processor(processor)
{
    m_constrainer.setFixedAspectRatio(
        static_cast<double>(Layout::DesignWidth) /
        static_cast<double>(Layout::DesignHeight));

    m_constrainer.setSizeLimits(
        Layout::MinWidth, Layout::MinHeight,
        Layout::MaxWidth, Layout::MaxHeight);

    setConstrainer(&m_constrainer);
    setResizable(true, true);

    const int savedW = processor.getPluginState().getSavedEditorWidth();
    const int savedH = processor.getPluginState().getSavedEditorHeight();

    if (savedW >= Layout::MinWidth && savedH >= Layout::MinHeight)
        setSize(savedW, savedH);
    else
        setSize(1280, 720);

    m_assistantOpen =
        processor.getPluginState().getSavedAssistantPanelOpen();

    const std::array<juce::String, 4> tabNames
    {
        "ALL SAMPLES", "DRUMS", "LOOPS", "ONE-SHOTS"
    };

    for (int i = 0; i < 4; ++i)
    {
        addAndMakeVisible(m_tabs[i]);
        m_tabs[i].setButtonText(tabNames[static_cast<size_t>(i)]);
        styleButton(m_tabs[i]);

        m_tabs[i].onClick = [this, i]
        {
            m_activeCategory = i;
            updateSampleVisibility();
            repaint();
        };
    }

    const std::array<juce::String, 4> navNames
    {
        "BROWSE", "FAVOURITES", "RECENT", "PACKS"
    };

    for (int i = 0; i < 4; ++i)
    {
        addAndMakeVisible(m_navigation[i]);
        m_navigation[i].setButtonText(navNames[static_cast<size_t>(i)]);
        styleButton(m_navigation[i]);
        m_navigation[i].onClick = [this, i]
        {
            m_activeNavigation = i;

            for (int n = 0; n < 4; ++n)
                m_navigation[n].setToggleState(
                    n == i, juce::dontSendNotification);

            updateSampleVisibility();
            repaint();
        };
    }

    m_navigation[0].setToggleState(true, juce::dontSendNotification);

    for (int i = 0; i < 6; ++i)
    {
        addAndMakeVisible(m_sampleRows[i]);
        styleButton(m_sampleRows[i]);

        m_sampleRows[i].onClick = [this, i]
        {
            if (i >= static_cast<int>(m_visibleSamples.size()))
                return;

            m_selectedSampleId =
                m_visibleSamples[static_cast<size_t>(i)].id;

            m_recentSampleIds.erase(
                std::remove(
                    m_recentSampleIds.begin(),
                    m_recentSampleIds.end(),
                    m_selectedSampleId),
                m_recentSampleIds.end());

            m_recentSampleIds.insert(
                m_recentSampleIds.begin(), m_selectedSampleId);

            if (m_recentSampleIds.size() > 20)
                m_recentSampleIds.resize(20);

            updateSampleVisibility();
            repaint();
        };
    }

    const std::array<juce::String, 4> macroNames
    {
        "PUNCH", "SPACE", "MOVEMENT", "TONE"
    };

    const std::array<juce::String, 4> parameterIDs
    {
        "macro_1", "macro_2", "macro_3", "macro_4"
    };

    for (int i = 0; i < 4; ++i)
    {
