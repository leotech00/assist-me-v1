#pragma once

// ============================================================
// DesignGrid.h
// Scales design-space coordinates to screen pixels.
//
// All layout is authored in the design canvas (1672 x 941).
// At runtime, DesignGrid holds the current scale factor
// s = editorWidth / 1672.0f and converts rectangles, sizes
// and font sizes so the UI scales proportionally from 60% to
// 200% of the reference size.
//
// Usage:
//   DesignGrid grid(getWidth(), getHeight());
//   auto topBar = grid.rect(0, 0, 1672, 48);  // full-width top bar
//   auto fontSize = grid.font(FontSize::md);
// ============================================================

#include "ui/theme/Tokens.h"
#include <juce_gui_basics/juce_gui_basics.h>

namespace assistme
{

class DesignGrid
{
public:
    /// Construct from the current editor pixel dimensions.
    explicit DesignGrid(int editorWidthPx, int editorHeightPx) noexcept
        : m_scale(static_cast<float>(editorWidthPx) /
                  static_cast<float>(Layout::DesignWidth))
    {
        juce::ignoreUnused(editorHeightPx);
    }

    /// Current scale factor (editorWidth / 1672).
    float scale() const noexcept { return m_scale; }

    /// Convert a design-space integer to screen pixels.
    int px(int designUnits) const noexcept
    {
        return juce::roundToInt(static_cast<float>(designUnits) * m_scale);
    }

    /// Convert a design-space float to screen pixels.
    float pxf(float designUnits) const noexcept
    {
        return designUnits * m_scale;
    }

    /// Convert a design-space rectangle to screen pixels.
    juce::Rectangle<int> rect(int x, int y, int w, int h) const noexcept
    {
        return { px(x), px(y), px(w), px(h) };
    }

    /// Convert a design-space float rectangle to screen pixels.
    juce::Rectangle<float> rectf(float x, float y, float w, float h) const noexcept
    {
        return { pxf(x), pxf(y), pxf(w), pxf(h) };
    }

    /// Scale a font size from design units to screen points.
    float font(float designFontSize) const noexcept
    {
        // Clamp to a readable minimum of 9 pt regardless of scale.
        return juce::jmax(9.0f, designFontSize * m_scale);
    }

    /// Scale a stroke width.
    float stroke(float designStrokeWidth) const noexcept
    {
        return juce::jmax(0.5f, designStrokeWidth * m_scale);
    }

private:
    float m_scale { 1.0f };
};

} // namespace assistme

