        repaint();
    };

    addAndMakeVisible(m_assistantToggle);
    m_assistantToggle.setButtonText(
        m_assistantOpen ? "AI PANEL  ON" : "AI PANEL  OFF");
    styleButton(m_assistantToggle);

    m_assistantToggle.onClick = [this]
    {
        m_assistantOpen = !m_assistantOpen;

        m_assistantOutput.setVisible(m_assistantOpen);
        m_assistantInput.setVisible(m_assistantOpen);
        m_sendButton.setVisible(m_assistantOpen);

        m_assistantToggle.setButtonText(
            m_assistantOpen ? "AI PANEL  ON" : "AI PANEL  OFF");

        m_processor.getPluginState().saveAssistantPanelOpen(
            m_assistantOpen);

        resized();
        repaint();
    };

    addAndMakeVisible(m_assistantOutput);
    m_assistantOutput.setMultiLine(true);
    m_assistantOutput.setReadOnly(true);
    m_assistantOutput.setScrollbarsShown(true);
    m_assistantOutput.setColour(
        juce::TextEditor::backgroundColourId,
        colour(Colours::SurfaceSunken));
    m_assistantOutput.setColour(
        juce::TextEditor::textColourId,
        colour(Colours::TextSecondary));
    m_assistantOutput.setColour(
        juce::TextEditor::outlineColourId,
        colour(Colours::Border));
    m_assistantOutput.setText(
        "ASSIST ME ASSISTANT\n\n"
        "Your production assistant workspace.\n\n"
        "The interface is ready. The AI service has not "
        "been connected yet.\n\n"
        "Backend integration will be added in a later milestone.");

    addAndMakeVisible(m_assistantInput);
    m_assistantInput.setMultiLine(false);
    m_assistantInput.setReturnKeyStartsNewLine(false);
    m_assistantInput.setTextToShowWhenEmpty(
