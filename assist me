void PluginEditor::resized()
{
    const DesignGrid grid(getWidth(), getHeight());

    const int assistantWidth =
        m_assistantOpen ? Layout::AssistantPanelWidth : 0;

    const int macroX =
        Layout::DesignWidth - assistantWidth - Layout::MacroColumnWidth;

    const int browserLeft =
        Layout::LeftNavWidth + Layout::FilterPanelWidth;

    const int browserWidth = macroX - browserLeft;

    const int assistantX =
        Layout::DesignWidth - Layout::AssistantPanelWidth;

    m_assistantToggle.setBounds(
        grid.rect(Layout::DesignWidth - 145, 8, 130, 32));

    for (int i = 0; i < 4; ++i)
    {
        m_tabs[i].setBounds(
            grid.rect(browserLeft + 12 + i * 112, 51, 104, 30));

        m_navigation[i].setBounds(
            grid.rect(4, 112 + i * 66, Layout::LeftNavWidth - 8, 48));
    }

    m_search.setBounds(
        grid.rect(browserLeft + 20, 160, browserWidth - 160, 34));

    m_favouriteButton.setBounds(
        grid.rect(browserLeft + browserWidth - 130, 160, 110, 34));

    for (int i = 0; i < 6; ++i)
    {
        m_sampleRows[i].setBounds(
            grid.rect(browserLeft + 16, 232 + i * 68,
                      browserWidth - 32, 54));
    }

    for (int i = 0; i < 4; ++i)
    {
        m_macros[i].setBounds(
            grid.rect(macroX + 5, 210 + i * 145,
                      Layout::MacroColumnWidth - 10, 72));
    }

    if (m_assistantOpen)
    {
        m_assistantOutput.setBounds(
            grid.rect(assistantX + 14, 164,
                      Layout::AssistantPanelWidth - 28, 590));

        m_assistantInput.setBounds(
            grid.rect(assistantX + 14, 770,
                      Layout::AssistantPanelWidth - 28, 46));

        m_sendButton.setBounds(
            grid.rect(assistantX + 14, 824,
                      Layout::AssistantPanelWidth - 28, 34));
    }

    m_transportButton.setBounds(
        grid.rect(16, Layout::DesignHeight -
                  Layout::TransportBarHeight + 4, 150, 28));

    updateSampleVisibility();
}

