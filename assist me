            juce::Slider::rotarySliderOutlineColourId,
            colour(Colours::Border));
        m_macros[i].setColour(
            juce::Slider::thumbColourId,
            colour(Colours::TextPrimary));

        m_macroAttachments[static_cast<size_t>(i)] =
            std::make_unique<SliderAttachment>(
                processor.getPluginState().apvts(),
                parameterIDs[static_cast<size_t>(i)],
                m_macros[i]);
    }

    addAndMakeVisible(m_search);
    m_search.setTextToShowWhenEmpty(
        "Search samples, packs and tags...",
        colour(Colours::TextTertiary));
    m_search.setColour(
        juce::TextEditor::backgroundColourId,
        colour(Colours::SurfaceSunken));
    m_search.setColour(
        juce::TextEditor::textColourId,
        colour(Colours::TextPrimary));
    m_search.setColour(
        juce::TextEditor::outlineColourId,
        colour(Colours::Border));
