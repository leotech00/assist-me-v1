void PluginEditor::updateSampleVisibility()
{
    FilterState filter;

    filter.textQuery = m_search.getText().trim();
    filter.pageIndex = 0;
    filter.pageSize = 200;

    if (m_activeCategory == 1)
        filter.sampleType = "DRUMS";
    else if (m_activeCategory == 2)
        filter.sampleType = "LOOPS";
    else if (m_activeCategory == 3)
        filter.sampleType = "ONE-SHOTS";

    filter.favouritesOnly = (m_activeNavigation == 1);

    auto result = m_libraryService.query(filter);

    m_visibleSamples = std::move(result.rows);

    // Recent samples are tracked for this editor session.
    if (m_activeNavigation == 2)
    {
        std::vector<SampleInfo> recentSamples;

        for (const auto id : m_recentSampleIds)
        {
            const auto found = std::find_if(
                m_visibleSamples.begin(),
                m_visibleSamples.end(),
                [id](const SampleInfo& sample)
                {
                    return sample.id == id;
                });

            if (found != m_visibleSamples.end())
                recentSamples.push_back(*found);
        }

        m_visibleSamples = std::move(recentSamples);
    }

    for (int i = 0; i < 6; ++i)
    {
        auto& row = m_sampleRows[static_cast<size_t>(i)];

        if (i >= static_cast<int>(m_visibleSamples.size()))
        {
            row.setVisible(false);
            continue;
        }

        const auto& sample = m_visibleSamples[static_cast<size_t>(i)];

        const auto bpmText = sample.bpm > 0.0f
            ? juce::String(sample.bpm, 0) + " BPM"
            : "N/A BPM";

        const auto detail =
            bpmText + "   " +
            sample.musicalKey + "   " +
            juce::String(sample.durationSeconds, 1) + "s";

        const auto favouriteText =
            sample.isFavourite ? "   [FAV]" : "";

        row.setButtonText(
            sample.title + "     " +
            sample.sampleType + "     " +
            detail + favouriteText);

        row.setColour(
            juce::TextButton::buttonColourId,
            sample.id == m_selectedSampleId
                ? colour(Colours::Selected)
                : colour(Colours::SurfaceSunken));

        row.setVisible(true);
    }

    bool selectedIsFavourite = false;

    const auto selected = std::find_if(
        m_visibleSamples.begin(),
        m_visibleSamples.end(),
        [this](const SampleInfo& sample)
        {
            return sample.id == m_selectedSampleId;
        });

    if (selected != m_visibleSamples.end())
        selectedIsFavourite = selected->isFavourite;

    m_favouriteButton.setButtonText(
        selectedIsFavourite ? "UNFAVOURITE" : "FAVOURITE");

    for (int i = 0; i < 4; ++i)
    {
        m_tabs[static_cast<size_t>(i)].setToggleState(
            i == m_activeCategory,
            juce::dontSendNotification);
    }
}

void PluginEditor::sendAssistantMessage()
{
    const auto message = m_assistantInput.getText().trim();

    if (message.isEmpty())
        return;

    const auto updated =
        m_assistantOutput.getText() +
        "\n\nYOU:\n" + message +
        "\n\nASSIST ME:\n"
        "The assistant backend is not connected yet. "
        "Your message was not sent to an AI service.";

    m_assistantOutput.setText(updated);
    m_assistantInput.clear();
}

